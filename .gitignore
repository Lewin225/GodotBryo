# Reference game copy — copyrighted assets, never committed
fresh_nv_copy/

# Build outputs (the .gdextension manifest in project/bin/ IS source — keep it)
native/bin/
native/src/gen/
project/bin/*.so
project/bin/*.dll
project/bin/*.framework

# Terrain3D (native/terrain3d, vendored submodule) build output — same
# never-commit-compiled-binaries convention as project/bin/ above. The
# .gdextension manifest and GDScript-side addon files ARE source, kept.
project/addons/terrain_3d/bin/
# Terrain streamer compiled extension output — local build artifact, not source
project/addons/terrain_streamer/bin/
*.o
*.os
*.obj
.sconsign.dblite
# native/tools/ compiled binaries are always extensionless (source is
# always .cpp/.h/.hpp/.sh) -- ignore everything there except real source,
# so a new one-off diagnostic tool's binary never needs its own line here.
native/tools/*
!native/tools/*.cpp
!native/tools/*.h
!native/tools/*.hpp
!native/tools/*.sh

# Godot editor artifacts
.godot/
project/.godot/

# Native Godot binary — large (~140MB), fetched per-machine, not source
tools/Godot_v4.7.1-stable_linux.x86_64

# Local NIF inspection tool installation — not project source
tools/NifSkope/

# Local GECK reference material — not project source
enginedocs/Geck/

# Local Godot source checkout — machine-local reference/build material
enginedocs/godot-4.7.2 source/

# Local dev screenshots/perf reports — not source
dev_progress_media/

# Local diagnostic output — generated by native/tools/dump_object
dump_object_output/

# OS/editor cruft
.DS_Store
*.swp

# Claude Code harness temp files
.claude/*.tmp.*
dino_delux_test.scn
project/esm_cache/
project/esm_mount/
