#!/usr/bin/env python
env = SConscript("../godot-cpp/SConstruct")

# The shared godot-cpp archive contains enough generated objects that GNU
# ar's direct argv can exceed this execution environment's ARG_MAX. A naive
# ${TEMPFILE(ARCOM)} response-file wrap (SCons' generic fix, matching
# godot-cpp's own web/Emscripten tool) does NOT work reliably with this
# host's GNU ar: confirmed directly -- `ar` returns success without ever
# creating the archive, and ranlib then fails because the file doesn't
# exist. GNU ar's own man page explains why: "If file does not exist, or
# cannot be read, then the [@file] option will be treated literally, and
# not removed" -- i.e. a bad/unreadable response file is silently ignored
# rather than erroring, so no real archive operation ever happens.
#
# This exact "too many args to ar" problem already has a proven fix in this
# same godot-cpp submodule -- native/godot-cpp/tools/my_spawn.py -- but it's
# gated to Windows only (exists() checks os.name == "nt"). Its technique
# doesn't rely on ar's own @file support at all: spawn `ar q archive member`
# once per object file instead of one giant argv. Mirrored here for POSIX,
# scoped to this extension's own build only (not touching the shared
# godot-cpp submodule, so nv_engine/Terrain3D's own builds are unaffected).
import subprocess


def _strip_quotes(arg):
	# SCons quotes each substituted token (TARGET/SOURCES) so a shell-joined
	# command line survives paths containing spaces -- this repo's own path
	# ("Claude New Vegas Port") is exactly such a case. subprocess.run's
	# list form does its own argv passing with no shell involved, so those
	# literal embedded quote characters must be stripped here, or ar
	# receives a path with literal quotes baked into the filename and
	# fails with "No such file or directory" -- confirmed directly.
	if len(arg) >= 2 and arg[0] == '"' and arg[-1] == '"':
		return arg[1:-1]
	return arg


def _posix_ar_spawn(sh, escape, cmd, args, env):
	cmdline = " ".join(args)
	if cmd.endswith("ar") and len(cmdline) > 32000:
		clean = [_strip_quotes(a) for a in args]
		# clean[0] = ar, clean[1] = ARFLAGS ("rc"), clean[2] = target archive,
		# clean[3:] = the long object-file list -- append one at a time.
		rv = 0
		for obj in clean[3:]:
			proc = subprocess.run([cmd, clean[1], clean[2], obj], env=env)
			rv = proc.returncode
			if rv:
				break
		return rv
	proc = subprocess.run(cmdline, shell=True, env=env)
	return proc.returncode


env["SPAWN"] = _posix_ar_spawn
env.Replace(ARFLAGS=["rc"])

env.Append(CPPPATH=["../src", "src"])
env.Append(LIBS=["z"])
sources = Glob("src/*.cpp") + Glob("../src/common/*.cpp") + Glob("../src/esm/esm_file.cpp")
library = env.SharedLibrary("../../project/addons/terrain_streamer/bin/libterrain_streamer{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources)
Default(library)
