[configuration]
entry_symbol = "nv_engine_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libnv_engine.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libnv_engine.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libnv_engine.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libnv_engine.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libnv_engine.macos.template_debug.framework"
macos.release = "res://bin/libnv_engine.macos.template_release.framework"
