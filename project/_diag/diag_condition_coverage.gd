extends Node

## Writes Plans/Completed Plans/Conditions/coverage.md: every condition function used by a CTDA
## in FalloutNV.esm, with its uses per record type, whether ScriptServer's
## registry implements it, and how many of its conditions pass anyway because
## an unimplemented function reads 0.

const OUTPUT := "../Plans/Completed Plans/Conditions/coverage.md"
## Record types whose conditions are evaluated today.
const EVALUATED := ["QUST", "TERM", "MESG", "INFO"]
const COMPARISONS := ["==", "!=", ">", ">=", "<", "<="]

func _ready() -> void:
	if not EsmServer.is_ready():
		await EsmServer.esm_ready
	var registry: ScriptFunctionRegistry = ScriptServer.function_registry
	var types: Array[String] = []
	var uses := {} # function index -> {record type -> count}
	var passes_at_zero := {} # function index -> {record type -> count}
	var global_compared := {} # function index -> count
	var total := 0
	for row: Dictionary in EsmServer.get_record_index():
		var type := String(row.get("record_type", ""))
		var raw: Dictionary = EsmServer.reader.get_record_data(int(row["form_id"]))
		for sub: Dictionary in raw.get("subrecords", []):
			if String(sub.get("type", "")) != "CTDA":
				continue
			var data: PackedByteArray = sub["data"]
			if data.size() < 12:
				continue
			total += 1
			if not types.has(type):
				types.append(type)
			var index := data.decode_u16(8)
			var by_type: Dictionary = uses.get_or_add(index, {})
			by_type[type] = int(by_type.get(type, 0)) + 1
			var flags := data[0] & 0x1F
			if (flags & ConditionSubrecord.FLAG_USE_GLOBAL) != 0:
				global_compared[index] = int(global_compared.get(index, 0)) + 1
			elif ConditionEvaluator.compare(0.0, (data[0] >> 5) as ConditionSubrecord.Comparison, data.decode_float(4)):
				var zero_by_type: Dictionary = passes_at_zero.get_or_add(index, {})
				zero_by_type[type] = int(zero_by_type.get(type, 0)) + 1
	types.sort_custom(func(a: String, b: String) -> bool: return _type_total(uses, a) > _type_total(uses, b))

	var rows: Array = []
	for index: int in uses:
		var function_name := ScriptConditionFunctions.name_for_index(index)
		var count := 0
		for type: String in uses[index]:
			count += int(uses[index][type])
		rows.append({"index": index, "name": function_name if not function_name.is_empty() else "#%d" % index,
				"count": count, "implemented": not function_name.is_empty() and registry.is_registered(function_name)})
	rows.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return a["count"] > b["count"] or (a["count"] == b["count"] and a["index"] < b["index"]))

	var lines: PackedStringArray = []
	lines.append("# Condition function coverage")
	lines.append("")
	lines.append("Generated by `project/_diag/diag_condition_coverage.tscn` from FalloutNV.esm and ScriptServer's")
	lines.append("function registry; re-run it after implementing functions. %d CTDAs, %d distinct functions." % [total, rows.size()])
	lines.append("")
	lines.append("\"Pass at 0\" counts an unimplemented function's conditions that pass anyway, because it reads 0")
	lines.append("and the comparison holds for 0 (`GetDead == 0`); those with a global comparison value are")
	lines.append("counted apart, as the global's value decides.")
	lines.append("")
	lines.append("## By record type")
	lines.append("")
	lines.append("| Type | CTDAs | Implemented | Unimplemented | Unimplemented, pass at 0 | Evaluated today |")
	lines.append("|---|---|---|---|---|---|")
	for type in types:
		var implemented := 0
		var unimplemented := 0
		var zero_pass := 0
		for row: Dictionary in rows:
			var n := int(uses[row["index"]].get(type, 0))
			if row["implemented"]:
				implemented += n
			else:
				unimplemented += n
		for row: Dictionary in rows:
			if not row["implemented"]:
				zero_pass += int(passes_at_zero.get(row["index"], {}).get(type, 0))
		lines.append("| %s | %d | %d (%s) | %d | %d | %s |" % [type, implemented + unimplemented, implemented,
				_percent(implemented, implemented + unimplemented), unimplemented, zero_pass, "yes" if EVALUATED.has(type) else "no"])
	lines.append("")

	lines.append("## Next to implement")
	lines.append("")
	lines.append("Unimplemented functions used by the record types evaluated today (%s), by use there." % ", ".join(EVALUATED))
	lines.append("")
	lines.append("| Function | Index | Uses in %s | All uses |" % "/".join(EVALUATED))
	lines.append("|---|---|---|---|")
	var next: Array = []
	for row: Dictionary in rows:
		if row["implemented"]:
			continue
		var evaluated_uses := 0
		for type in EVALUATED:
			evaluated_uses += int(uses[row["index"]].get(type, 0))
		if evaluated_uses > 0:
			next.append([row, evaluated_uses])
	next.sort_custom(func(a: Array, b: Array) -> bool: return a[1] > b[1])
	for entry: Array in next:
		lines.append("| %s | %d | %d | %d |" % [entry[0]["name"], entry[0]["index"], entry[1], entry[0]["count"]])
	lines.append("")

	lines.append("## Every function")
	lines.append("")
	lines.append("| Function | Index | Uses | Implemented | Pass at 0 | Global compared | By type |")
	lines.append("|---|---|---|---|---|---|---|")
	for row: Dictionary in rows:
		var by_type: Array[String] = []
		for type in types:
			if uses[row["index"]].has(type):
				by_type.append("%s %d" % [type, uses[row["index"]][type]])
		lines.append("| %s | %d | %d | %s | %s | %s | %s |" % [row["name"], row["index"], row["count"],
				"yes" if row["implemented"] else "no",
				"" if row["implemented"] else str(_sum(passes_at_zero.get(row["index"], {}))),
				"" if row["implemented"] else str(global_compared.get(row["index"], 0)),
				", ".join(by_type)])

	var path := ProjectSettings.globalize_path("res://").path_join(OUTPUT).simplify_path()
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("wrote %s: %d CTDAs, %d functions" % [path, total, rows.size()])
	get_tree().quit()

static func _type_total(uses: Dictionary, type: String) -> int:
	var n := 0
	for index: int in uses:
		n += int(uses[index].get(type, 0))
	return n

## The sum of a {record type -> count} dictionary.
static func _sum(by_type: Dictionary) -> int:
	var n := 0
	for type: String in by_type:
		n += int(by_type[type])
	return n

static func _percent(part: int, whole: int) -> String:
	return "%.1f%%" % (100.0 * part / whole) if whole > 0 else "-"
