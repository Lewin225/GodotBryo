extends RefCounted
class_name NifArchiveSource

## Stand-in for ArchiveServer: opens every BSA once, builds a normalized
## path -> (archive, entry) index, and extracts bytes on demand.
##
## Extraction is mutex-guarded because BsaArchive still uses a shared file
## cursor (fseek/fread). The pread()/ReadFile()+OVERLAPPED patch that makes
## concurrent read_at() safe by construction is a named native prerequisite
## in nif_server_v2.md §4 and is NOT done, so parallel resolves serialise on
## IO here while parsing and decoding stay parallel. Replacing this class
## with ArchiveServer removes the mutex.

var _readers: Array = []
var _index: Dictionary = {}      # canonical path -> [reader index, entry path as stored]
var _mutex := Mutex.new()
var _ready := false
var _error := ""


static func canonical(path: String) -> String:
	var p := path.replace("\\", "/").to_lower().strip_edges()
	while p.begins_with("/"):
		p = p.substr(1)
	if p.begins_with("meshes/"):
		p = p.substr(7)
	if p.begins_with("textures/"):
		p = p.substr(9)
	return p


func open_data_dir(data_dir: String) -> bool:
	if _ready:
		return true
	if data_dir.is_empty():
		_error = "no data directory configured"
		return false
	var dir := DirAccess.open(data_dir)
	if dir == null:
		_error = "cannot open data directory: " + data_dir
		return false
	var names := dir.get_files()
	names.sort()
	for name in names:
		if not name.to_lower().ends_with(".bsa"):
			continue
		var reader := BsaReader.new()
		if not reader.open(data_dir.path_join(name)):
			push_warning("NifArchiveSource: %s failed to open: %s" % [name, reader.get_last_error()])
			continue
		var idx := _readers.size()
		_readers.append(reader)
		for entry in reader.list_entries():
			var stored := String(entry)
			var key := canonical(stored)
			# First archive wins; BSA priority is ArchiveServer's job later.
			if not _index.has(key):
				_index[key] = [idx, stored]
	_ready = true
	return true


func has(path: String) -> bool:
	return _index.has(canonical(path))


## Thread-safe. Returns an empty PackedByteArray when not found.
func read(path: String) -> PackedByteArray:
	var key := canonical(path)
	if not _index.has(key):
		return PackedByteArray()
	var slot: Array = _index[key]
	var reader = _readers[slot[0]]
	_mutex.lock()
	var bytes: PackedByteArray = reader.extract(String(slot[1]))
	_mutex.unlock()
	return bytes


func get_error() -> String:
	return _error


func get_entry_count() -> int:
	return _index.size()
