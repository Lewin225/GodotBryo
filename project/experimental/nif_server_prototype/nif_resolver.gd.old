extends RefCounted
class_name NifResolver

## Worker-side half of NifServer. Touches raw data only -- never an ArrayMesh,
## ImageTexture, Material, Shape3D, decoded Image or any Node
## (nif_server_v2.md §4). Flat float arrays are widened to typed Packed*Arrays
## here because that is plain-data work with no server calls in it.

const NifResolveResultScript := preload("res://GodotBryo/Servers/NifServer/nif_resolve_result.gd")


static func resolve(source, nif_path: String, flatten_static: bool) -> NifResolveResult:
	var result: NifResolveResult = NifResolveResultScript.new()
	result.path = nif_path
	result.flatten_static = flatten_static

	var bytes: PackedByteArray = source.read(nif_path)
	if bytes.is_empty():
		result.error = "not found in any archive"
		return result

	var nif := NifReader.new()
	if not nif.load(bytes):
		result.error = "NifReader.load() rejected the file: " + nif.get_last_error()
		return result

	if not flatten_static:
		result.nodes = nif.get_scene_nodes()

	# Skins join back to their shape by the shape's own authored name.
	var skin_by_target := {}
	if not flatten_static:
		for skin in nif.get_skin_data():
			skin_by_target[String(skin.get("target_node_name", ""))] = skin
	result.is_skinned = not skin_by_target.is_empty()

	var count := nif.get_submesh_count()
	result.submesh_count = count
	for i in count:
		var name := String(nif.get_submesh_name(i))
		var entry := {
			"name": name,
			"owning_node_index": int(nif.get_submesh_owning_node_index(i)),
			"transform": nif.get_transform(i),
			"verts": _to_vec3(nif.get_positions(i)),
			"normals": _to_vec3(nif.get_normals(i)),
			"uvs": _to_vec2(nif.get_uvs(i)),
			"colors": nif.get_colors(i),
			"indices": nif.get_indices(i),
			"material": _material_of(nif, i),
			"skin": null,
		}
		if entry["verts"].is_empty() or entry["indices"].is_empty():
			result.note("submesh %d ('%s') has no geometry, skipped" % [i, name])
			continue
		if skin_by_target.has(name):
			var s: Dictionary = skin_by_target[name]
			entry["skin"] = {
				"bone_names": s.get("bone_names", []),
				"bind_transforms": s.get("bone_bind_transforms", []),
				"bone_indices": s.get("bone_indices", PackedInt32Array()),
				"bone_weights": s.get("bone_weights", PackedFloat32Array()),
			}
		result.meshes.append(entry)

	if nif.has_collision_data():
		result.collision_shapes = nif.get_collision_shapes()
		result.physics_bodies = nif.get_physics_bodies()

	# Gather texture bytes while still on the worker. Decode/upload is
	# main-thread work and belongs to TextureServer once it exists.
	for entry in result.meshes:
		var mat: Dictionary = entry["material"]
		for key in ["diffuse", "normal", "glow"]:
			var tex := String(mat.get(key, ""))
			if tex.is_empty() or result.texture_bytes.has(tex):
				continue
			var tb: PackedByteArray = source.read(tex)
			if tb.is_empty():
				result.note("texture not found: " + tex)
			result.texture_bytes[tex] = tb

	result.ok = true
	return result


static func _material_of(nif: NifReader, i: int) -> Dictionary:
	var alpha: Dictionary = nif.get_alpha_info(i)
	return {
		"diffuse": String(nif.get_texture_path(i)),
		"normal": String(nif.get_normal_texture_path(i)),
		"glow": String(nif.get_glow_texture_path(i)),
		"unlit": bool(nif.is_unlit(i)),
		"double_sided": bool(nif.is_double_sided(i)),
		"alpha_blend": bool(alpha.get("blend_enabled", false)),
		"alpha_test": bool(alpha.get("test_enabled", false)),
		"alpha_threshold": float(alpha.get("threshold", 0.5)),
	}


static func _to_vec3(flat: PackedFloat32Array) -> PackedVector3Array:
	var out := PackedVector3Array()
	out.resize(flat.size() / 3)
	for i in out.size():
		out[i] = Vector3(flat[i * 3], flat[i * 3 + 1], flat[i * 3 + 2])
	return out


static func _to_vec2(flat: PackedFloat32Array) -> PackedVector2Array:
	var out := PackedVector2Array()
	out.resize(flat.size() / 2)
	for i in out.size():
		out[i] = Vector2(flat[i * 2], flat[i * 2 + 1])
	return out
