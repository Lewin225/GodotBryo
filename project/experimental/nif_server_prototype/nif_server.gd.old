extends Node

## NifServer -- one NIF path in, one honest Godot tree out.
##
## Implements nif_server_v2.md. The result reflects the file's actual
## contents, never the caller's intent: there is no humanoid, actor,
## equipment or LOD entry point, and nothing is withheld because no consumer
## wants it yet. Merging several returns into one rig (an actor) is the
## caller's job (§9).
##
## Intended as an autoload; also works parented anywhere for tests/demos.

const NifArchiveSourceScript := preload("res://GodotBryo/Servers/NifServer/nif_archive_source.gd")
const NifResolverScript := preload("res://GodotBryo/Servers/NifServer/nif_resolver.gd")
const NifBuilderScript := preload("res://GodotBryo/Servers/NifServer/nif_builder.gd")

## Max _build() calls drained per frame (§4).
@export var builds_per_frame_budget := 12
## Admission cap on concurrent _resolve() tasks. -1 = max(2, cpus - 1).
@export var num_workers := -1

var _source
var _source_ready := false
var _cache := {}          # key -> NifResolveResult
var _inflight := {}       # key -> {waiters: Array, task_id: int}
var _pending := []        # admission queue of keys waiting for a worker slot
var _build_queue := []    # [{result, waiters}]
var _texture_cache := {}  # texture path -> ImageTexture | null | raw bytes
var _active_resolves := 0
var _shutting_down := false

var _stats := {
	"resolve_cache_hits": 0,
	"resolve_cache_misses": 0,
	"duplicate_waiter_count": 0,
	"resolve_failure_count": 0,
	"total_build_count": 0,
	"builds_this_frame": 0,
	"shutdown_cancel_count": 0,
}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS


func _exit_tree() -> void:
	_shutting_down = true
	for key in _inflight.keys():
		for w in _inflight[key]["waiters"]:
			_deliver(w, null)
			_stats["shutdown_cancel_count"] += 1
	_inflight.clear()
	_build_queue.clear()


## Public entry point (§3.1). `on_complete` must be a method on `owner`, is
## invoked exactly once on the main thread, and receives the built Node3D or
## null. A successful callback transfers ownership: parent it or free it.
func request(nif_path: String, owner: Node, on_complete: Callable, flatten_static := false) -> void:
	if _shutting_down:
		_deliver({"owner": owner, "cb": on_complete}, null)
		return
	if nif_path.strip_edges().is_empty():
		push_warning("NifServer: empty path is an invalid request")
		_deliver({"owner": owner, "cb": on_complete}, null)
		return
	if not _ensure_source():
		_deliver({"owner": owner, "cb": on_complete}, null)
		return

	var canonical := NifArchiveSourceScript.canonical(nif_path)
	var key := "%s|%d" % [canonical, int(flatten_static)]
	var waiter := {"owner": owner, "cb": on_complete}

	if _cache.has(key):
		_stats["resolve_cache_hits"] += 1
		# Cache hits still pay the build budget: v1 constructs a fresh tree
		# per delivered instance rather than duplicating a prototype (§12).
		_build_queue.append({"result": _cache[key], "waiters": [waiter]})
		return

	if _inflight.has(key):
		_stats["duplicate_waiter_count"] += 1
		_inflight[key]["waiters"].append(waiter)
		return

	_stats["resolve_cache_misses"] += 1
	_inflight[key] = {"waiters": [waiter], "canonical": canonical, "flatten": flatten_static}
	_pending.append(key)
	_admit()


## KF animation (§7). Returns an AnimationLibrary keyed by sequence name --
## 4,981 of 5,014 shipped KFs hold one sequence, but 33 hold 2-5, so a single
## Animation cannot represent the corpus. Track paths are the authored target
## names; binding to a real rig is caller-side, because a KF addresses a
## composed rig (skeleton + weapon + animobjects), not one file.
##
## Worker-safe: Animation/AnimationLibrary construction and track mutation are
## verified safe off the main thread (tools/godot_anim_thread_check/).
func request_kf(kf_path: String) -> AnimationLibrary:
	if not _ensure_source():
		return null
	var bytes: PackedByteArray = _source.read(kf_path)
	if bytes.is_empty():
		return null
	var nif := NifReader.new()
	if not nif.load(bytes):
		return null
	var lib := AnimationLibrary.new()
	for seq in nif.get_animation_sequences():
		var anim := _animation_from_sequence(seq)
		if anim != null:
			var seq_name := String(seq.get("name", ""))
			lib.add_animation(seq_name if not seq_name.is_empty() else "Sequence%d" % lib.get_animation_list().size(), anim)
	return lib


func get_stats() -> Dictionary:
	var out := _stats.duplicate()
	out["pending_resolve_count"] = _active_resolves
	out["pending_admission_count"] = _pending.size()
	out["pending_build_count"] = _build_queue.size()
	out["resident_nif_count"] = _cache.size()
	out["resident_texture_count"] = _texture_cache.size()
	out["archive_entry_count"] = _source.get_entry_count() if _source_ready else 0
	return out


func reset_stats() -> void:
	for k in _stats.keys():
		_stats[k] = 0


func _process(_delta: float) -> void:
	_stats["builds_this_frame"] = 0
	var budget: int = maxi(1, builds_per_frame_budget)
	while not _build_queue.is_empty() and _stats["builds_this_frame"] < budget:
		var job = _build_queue.pop_front()
		var node: Node3D = NifBuilderScript.build(job["result"], _texture_cache)
		_stats["builds_this_frame"] += 1
		_stats["total_build_count"] += 1
		var first := true
		for w in job["waiters"]:
			# Each waiter gets its own tree; a Node has one parent.
			var delivered: Node3D = node if first else NifBuilderScript.build(job["result"], _texture_cache)
			first = false
			_deliver(w, delivered)


func _worker_cap() -> int:
	if num_workers == -1:
		return maxi(2, OS.get_processor_count() - 1)
	return maxi(1, num_workers)


func _admit() -> void:
	while not _pending.is_empty() and _active_resolves < _worker_cap():
		var key: String = _pending.pop_front()
		if not _inflight.has(key):
			continue
		var rec: Dictionary = _inflight[key]
		_active_resolves += 1
		rec["task_id"] = WorkerThreadPool.add_task(_resolve_task.bind(key, rec["canonical"], rec["flatten"]))


## Worker thread body. Raw data only.
func _resolve_task(key: String, canonical: String, flatten: bool) -> void:
	var result: NifResolveResult = NifResolverScript.resolve(_source, canonical, flatten)
	_on_resolved.bind(key, result).call_deferred()


func _on_resolved(key: String, result: NifResolveResult) -> void:
	_active_resolves = maxi(0, _active_resolves - 1)
	if not _inflight.has(key):
		_admit()
		return
	var rec: Dictionary = _inflight[key]
	_inflight.erase(key)

	if not result.ok:
		_stats["resolve_failure_count"] += 1
		push_warning("NifServer: %s -- %s" % [result.path, result.error])
	for msg in result.diagnostics:
		push_warning("NifServer: %s -- %s" % [result.path, msg])

	# Cache failures too, so a missing file is not re-read every request.
	_cache[key] = result
	# Texture bytes move into the shared decode cache; decode is lazy and
	# happens once per path inside the builder.
	for path in result.texture_bytes:
		if not _texture_cache.has(path):
			var b: PackedByteArray = result.texture_bytes[path]
			_texture_cache[path] = null if b.is_empty() else b
	result.texture_bytes.clear()

	if result.ok:
		_build_queue.append({"result": result, "waiters": rec["waiters"]})
	else:
		for w in rec["waiters"]:
			_deliver(w, null)
	_admit()


func _deliver(waiter: Dictionary, node: Node3D) -> void:
	var owner = waiter.get("owner")
	var cb: Callable = waiter.get("cb")
	if owner == null or not is_instance_valid(owner) or not cb.is_valid():
		# Owner went away: skip the callback and never leave an orphan (§3.2).
		if node != null:
			node.queue_free()
		return
	cb.call(node)
	# Ownership transferred. If the callback neither parented nor freed it,
	# NifServer frees it rather than leaking (§3.2).
	if node != null and is_instance_valid(node) and node.get_parent() == null:
		push_warning("NifServer: callback left the result unparented; freeing it")
		node.queue_free()


func _ensure_source() -> bool:
	if _source_ready:
		return true
	_source = NifArchiveSourceScript.new()
	var data_dir := ""
	if Engine.has_singleton("GameDataSettings"):
		data_dir = String(Engine.get_singleton("GameDataSettings").get_data_dir())
	elif get_tree() != null and get_tree().root.has_node("GameDataSettings"):
		data_dir = String(get_tree().root.get_node("GameDataSettings").get_data_dir())
	if data_dir.is_empty():
		data_dir = _fallback_data_dir()
	if not _source.open_data_dir(data_dir):
		push_error("NifServer: " + _source.get_error())
		return false
	_source_ready = true
	return true


func _fallback_data_dir() -> String:
	var cfg := ConfigFile.new()
	if cfg.load("res://game_data.cfg") == OK:
		return String(cfg.get_value("game_data", "data_dir", ""))
	return ""


func _animation_from_sequence(seq: Dictionary) -> Animation:
	var anim := Animation.new()
	var stop := float(seq.get("stop_time", 0.0))
	var start := float(seq.get("start_time", 0.0))
	anim.length = maxf(stop - start, 0.001)
	anim.loop_mode = Animation.LOOP_LINEAR if int(seq.get("cycle_type", 0)) == 0 else Animation.LOOP_NONE
	var tracks := 0
	var unnamed := 0
	for t in seq.get("tracks", []):
		var target := String(t.get("target_node_name", t.get("target_name", "")))
		if target.is_empty():
			# nif_server_v2.md §7.4: five shipped KFs (file version 20.0.0.4)
			# address targets by byte offset into a NiStringPalette instead of
			# by inline name. The native layer does not resolve that form, so
			# the target arrives empty and the track cannot be bound. Needs a
			# native getter before those five files work.
			unnamed += 1
			continue
		tracks += _add_vec3_track(anim, target, t.get("translation_keys", []), Animation.TYPE_POSITION_3D, start)
		tracks += _add_quat_track(anim, target, t.get("quaternion_keys", []), start)
		tracks += _add_vec3_track(anim, target, t.get("scale_keys", []), Animation.TYPE_SCALE_3D, start)
	if tracks == 0 and unnamed > 0:
		push_warning("NifServer: '%s' has %d controlled block(s) addressed through a NiStringPalette; unsupported until the native layer resolves palette offsets (v2 §7.4)"
			% [String(seq.get("name", "")), unnamed])
	return anim if tracks > 0 else null


func _add_vec3_track(anim: Animation, target: String, keys: Array, type: int, start: float) -> int:
	if keys.is_empty():
		return 0
	var idx := anim.add_track(type)
	anim.track_set_path(idx, NodePath(target))
	for k in keys:
		var raw = k.get("value", Vector3.ZERO)
		# NIF scale keys are a single uniform float; position keys are Vector3.
		var v: Vector3 = raw if raw is Vector3 else Vector3(raw, raw, raw)
		var t := float(k.get("time", 0.0)) - start
		if type == Animation.TYPE_POSITION_3D:
			anim.position_track_insert_key(idx, t, v)
		else:
			anim.scale_track_insert_key(idx, t, v)
	return 1


func _add_quat_track(anim: Animation, target: String, keys: Array, start: float) -> int:
	if keys.is_empty():
		return 0
	var idx := anim.add_track(Animation.TYPE_ROTATION_3D)
	anim.track_set_path(idx, NodePath(target))
	for k in keys:
		anim.rotation_track_insert_key(idx, float(k.get("time", 0.0)) - start, k.get("value", Quaternion.IDENTITY))
	return 1
