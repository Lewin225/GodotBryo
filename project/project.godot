; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodotByro"
run/main_scene="res://game.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameDataSettings="*res://game_data_settings.gd"
GodotBryoSettings="*res://godot_bryo_settings.gd"
ArchiveServer="*res://GodotBryo/Servers/ArchiveServer/archive_server.gd"
TextureServer="*res://GodotBryo/Servers/TextureServer/texture_server.gd"
NifServer="*res://GodotBryo/Servers/NifServer/nif_server.gd"
EsmServer="*res://GodotBryo/Servers/EsmServer/esm_server.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/subwindows/embed_subwindows=false

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg", "res://addons/script_viewer/plugin.cfg", "res://addons/godotbryo_browser/plugin.cfg")

[godotbryo]

use_nif_server=false

