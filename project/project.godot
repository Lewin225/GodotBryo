; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodotByro"
run/main_scene="res://launcher.tscn"
config/features=PackedStringArray("4.7")
run/max_fps=144

[autoload]

GameDataSettings="*res://game_data_settings.gd"
GodotBryoSettings="*res://godot_bryo_settings.gd"
ArchiveServer="*res://GodotBryo/Servers/ArchiveServer/archive_server.gd"
TextureServer="*res://GodotBryo/Servers/TextureServer/texture_server.gd"
NifServer="*res://GodotBryo/Servers/NifServer/nif_server.gd"
FaceGenServer="*res://GodotBryo/Servers/FaceGenServer/face_gen_server.gd"
EsmServer="*res://GodotBryo/Servers/EsmServer/esm_server.gd"
ScriptServer="*res://GodotBryo/Servers/ScriptServer/script_server.gd"
QuestServer="*res://GodotBryo/Servers/QuestServer/quest_server.gd"
DialogueServer="*res://GodotBryo/Servers/DialogueServer/dialogue_server.gd"
NpcSimulationServer="*res://GodotBryo/Servers/NpcSimulationServer/nav_npc_simulation_server.gd"
SaveServer="*res://GodotBryo/Servers/SaveServer/save_server.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/subwindows/embed_subwindows=false
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/SunshineClouds2/plugin.cfg", "res://addons/godotbryo_browser/plugin.cfg", "res://addons/script_viewer/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

